# n8n Docker config — used by docker-compose.yml via ENV_FILE.
# Local default: ENV_FILE=.env.example
# Production: set ENV_FILE=.env (and keep .env gitignored), chmod 600 .env

# Required: generate once and BACK IT UP (encrypts credentials)
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Hostname in generated URLs (no scheme). Local: localhost — production: your domain
N8N_HOST=localhost
# Local + http-only nginx: http — production behind TLS: https://yourdomain/
WEBHOOK_URL=http://localhost/
N8N_EDITOR_BASE_URL=http://localhost
# Production example:
# N8N_HOST=n8n.example.com
# WEBHOOK_URL=https://n8n.example.com/
# N8N_EDITOR_BASE_URL=https://n8n.example.com

# Session cookies: n8n uses Secure cookies when you use HTTPS (recommended). Opening the editor at
# http://YOUR_SERVER_IP will not keep login unless you set the line below (less safe; emergency only).
# N8N_SECURE_COOKIE=false

# Public webhooks: shared secret checked in workflow (import workflows/webhook-secret-guard-template.json).
# Generate: openssl rand -hex 32
# Callers send header: X-Webhook-Secret: <this value>
WEBHOOK_SHARED_SECRET=
# Default false in docker-compose so Code node can read WEBHOOK_SHARED_SECRET via $env.
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Execution / binary cleanup (images and other binary IO land under ~/.n8n, then prune removes them with old executions)
EXECUTIONS_DATA_MAX_AGE=24
EXECUTIONS_DATA_PRUNE_MAX_COUNT=100
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=15
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15

# Persisted state + SQLite location
# Choose where data lives on the host (bind mount).
# Default is inside this repo folder at ./data/n8n (relative to this file).
N8N_DATA_DIR=./data/n8n
N8N_USER_FOLDER=/home/node/.n8n
DB_TYPE=sqlite
DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite
DB_SQLITE_VACUUM_ON_STARTUP=false

# Image pin (optional)
# N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.76.1

TZ=UTC
GENERIC_TIMEZONE=UTC

# Optional hardening / ops
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

LETSENCRYPT_DIR=./certs/letsencrypt
CERTBOT_WEBROOT=./certs/certbot

# First-time TLS: NGINX_CONF=./nginx/http-only.conf then certbot; then ./nginx/nginx.conf
NGINX_CONF=./nginx/http-only.conf
